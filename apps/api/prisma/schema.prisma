// RestaurantOS data model — Phase 2 (platform, identity, setup).
// Constraints Prisma cannot express (RLS, composite same-tenant FKs, CHECKs, partial uniques, grants)
// live in hand-written SQL migrations (ADR-0003); see docs/04-data-dictionary.md.

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

// ───────────────────────────── Platform ─────────────────────────────

model Plan {
  id              String            @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  code            String            @unique
  nameAr          String            @map("name_ar")
  nameEn          String            @map("name_en")
  billingInterval String            @map("billing_interval")
  price           Decimal           @db.Decimal(19, 4)
  currencyCode    String            @map("currency_code") @db.Char(3)
  trialDays       Int               @default(14) @map("trial_days")
  isPublic        Boolean           @default(true) @map("is_public")
  archivedAt      DateTime?         @map("archived_at") @db.Timestamptz(6)
  createdAt       DateTime          @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt       DateTime          @updatedAt @map("updated_at") @db.Timestamptz(6)
  entitlements    PlanEntitlement[]
  subscriptions   Subscription[]

  @@map("plans")
}

model PlanEntitlement {
  id         String  @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  planId     String  @map("plan_id") @db.Uuid
  featureKey String  @map("feature_key")
  limitValue Int?    @map("limit_value")
  enabled    Boolean @default(true)
  plan       Plan    @relation(fields: [planId], references: [id])

  @@unique([planId, featureKey])
  @@map("plan_entitlements")
}

model Tenant {
  id            String          @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  legalName     String          @map("legal_name")
  displayName   String          @map("display_name")
  slug          String          @unique
  countryCode   String          @map("country_code") @db.Char(2)
  defaultLocale String          @map("default_locale")
  baseCurrency  String          @map("base_currency") @db.Char(3)
  timezone      String
  status        String          @default("active")
  createdAt     DateTime        @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt     DateTime        @updatedAt @map("updated_at") @db.Timestamptz(6)
  closedAt      DateTime?       @map("closed_at") @db.Timestamptz(6)
  subscriptions Subscription[]
  memberships   Membership[]
  settings      TenantSettings?
  branches      Branch[]

  @@map("tenants")
}

model Subscription {
  id                 String    @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  tenantId           String    @map("tenant_id") @db.Uuid
  planId             String    @map("plan_id") @db.Uuid
  status             String
  trialEndsAt        DateTime? @map("trial_ends_at") @db.Timestamptz(6)
  currentPeriodStart DateTime  @map("current_period_start") @db.Timestamptz(6)
  currentPeriodEnd   DateTime  @map("current_period_end") @db.Timestamptz(6)
  graceEndsAt        DateTime? @map("grace_ends_at") @db.Timestamptz(6)
  cancelAtPeriodEnd  Boolean   @default(false) @map("cancel_at_period_end")
  externalRef        String?   @map("external_ref")
  createdAt          DateTime  @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt          DateTime  @updatedAt @map("updated_at") @db.Timestamptz(6)
  tenant             Tenant    @relation(fields: [tenantId], references: [id])
  plan               Plan      @relation(fields: [planId], references: [id])

  @@index([tenantId])
  @@map("subscriptions")
}

model PlatformUser {
  id               String            @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  email            String            @unique
  passwordHash     String            @map("password_hash")
  fullName         String            @map("full_name")
  role             String
  disabledAt       DateTime?         @map("disabled_at") @db.Timestamptz(6)
  failedLoginCount Int               @default(0) @map("failed_login_count")
  lockedUntil      DateTime?         @map("locked_until") @db.Timestamptz(6)
  lastLoginAt      DateTime?         @map("last_login_at") @db.Timestamptz(6)
  createdAt        DateTime          @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt        DateTime          @updatedAt @map("updated_at") @db.Timestamptz(6)
  sessions         PlatformSession[]

  @@map("platform_users")
}

model PlatformSession {
  id             String       @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  platformUserId String       @map("platform_user_id") @db.Uuid
  tokenHash      String       @unique @map("token_hash")
  csrfTokenHash  String       @map("csrf_token_hash")
  ip             String?
  userAgent      String?      @map("user_agent")
  createdAt      DateTime     @default(now()) @map("created_at") @db.Timestamptz(6)
  lastSeenAt     DateTime     @default(now()) @map("last_seen_at") @db.Timestamptz(6)
  idleExpiresAt  DateTime     @map("idle_expires_at") @db.Timestamptz(6)
  expiresAt      DateTime     @map("expires_at") @db.Timestamptz(6)
  platformUser   PlatformUser @relation(fields: [platformUserId], references: [id], onDelete: Cascade)

  @@map("platform_sessions")
}

model PlatformAuditLog {
  id             String   @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  platformUserId String?  @map("platform_user_id") @db.Uuid
  action         String
  targetType     String   @map("target_type")
  targetId       String?  @map("target_id") @db.Uuid
  tenantId       String?  @map("tenant_id") @db.Uuid
  ip             String?
  requestId      String?  @map("request_id")
  changes        Json?
  createdAt      DateTime @default(now()) @map("created_at") @db.Timestamptz(6)

  @@index([tenantId, createdAt])
  @@map("platform_audit_logs")
}

// ───────────────────────────── Identity ─────────────────────────────

model User {
  id               String               @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  email            String               @unique
  /// NULL until the invited user sets a password through the invite link.
  passwordHash     String?              @map("password_hash")
  fullName         String               @map("full_name")
  locale           String               @default("ar-EG")
  emailVerifiedAt  DateTime?            @map("email_verified_at") @db.Timestamptz(6)
  lastLoginAt      DateTime?            @map("last_login_at") @db.Timestamptz(6)
  disabledAt       DateTime?            @map("disabled_at") @db.Timestamptz(6)
  failedLoginCount Int                  @default(0) @map("failed_login_count")
  lockedUntil      DateTime?            @map("locked_until") @db.Timestamptz(6)
  createdAt        DateTime             @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt        DateTime             @updatedAt @map("updated_at") @db.Timestamptz(6)
  sessions         Session[]
  memberships      Membership[]
  resetTokens      PasswordResetToken[]

  @@map("users")
}

model Session {
  id             String   @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  userId         String   @map("user_id") @db.Uuid
  tokenHash      String   @unique @map("token_hash")
  csrfTokenHash  String   @map("csrf_token_hash")
  activeTenantId String?  @map("active_tenant_id") @db.Uuid
  ip             String?
  userAgent      String?  @map("user_agent")
  createdAt      DateTime @default(now()) @map("created_at") @db.Timestamptz(6)
  lastSeenAt     DateTime @default(now()) @map("last_seen_at") @db.Timestamptz(6)
  idleExpiresAt  DateTime @map("idle_expires_at") @db.Timestamptz(6)
  expiresAt      DateTime @map("expires_at") @db.Timestamptz(6)
  user           User     @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
  @@map("sessions")
}

model PasswordResetToken {
  id        String    @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  userId    String    @map("user_id") @db.Uuid
  tokenHash String    @unique @map("token_hash")
  purpose   String
  expiresAt DateTime  @map("expires_at") @db.Timestamptz(6)
  usedAt    DateTime? @map("used_at") @db.Timestamptz(6)
  createdAt DateTime  @default(now()) @map("created_at") @db.Timestamptz(6)
  user      User      @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
  @@map("password_reset_tokens")
}

model Permission {
  key             String           @id
  module          String
  isSensitive     Boolean          @map("is_sensitive")
  rolePermissions RolePermission[]

  @@map("permissions")
}

model Role {
  id              String           @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  tenantId        String           @map("tenant_id") @db.Uuid
  name            String
  templateKey     String?          @map("template_key")
  isSystem        Boolean          @default(false) @map("is_system")
  rowVersion      Int              @default(1) @map("row_version")
  createdAt       DateTime         @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt       DateTime         @updatedAt @map("updated_at") @db.Timestamptz(6)
  createdBy       String?          @map("created_by") @db.Uuid
  updatedBy       String?          @map("updated_by") @db.Uuid
  rolePermissions RolePermission[]
  memberships     Membership[]

  @@index([tenantId])
  @@map("roles")
}

model RolePermission {
  tenantId      String     @map("tenant_id") @db.Uuid
  roleId        String     @map("role_id") @db.Uuid
  permissionKey String     @map("permission_key")
  role          Role       @relation(fields: [roleId], references: [id], onDelete: Cascade)
  permission    Permission @relation(fields: [permissionKey], references: [key])

  @@id([roleId, permissionKey])
  @@index([tenantId])
  @@map("role_permissions")
}

model Membership {
  id          String             @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  tenantId    String             @map("tenant_id") @db.Uuid
  userId      String             @map("user_id") @db.Uuid
  roleId      String             @map("role_id") @db.Uuid
  status      String             @default("active")
  allBranches Boolean            @default(true) @map("all_branches")
  rowVersion  Int                @default(1) @map("row_version")
  createdAt   DateTime           @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt   DateTime           @updatedAt @map("updated_at") @db.Timestamptz(6)
  createdBy   String?            @map("created_by") @db.Uuid
  updatedBy   String?            @map("updated_by") @db.Uuid
  tenant      Tenant             @relation(fields: [tenantId], references: [id])
  user        User               @relation(fields: [userId], references: [id])
  role        Role               @relation(fields: [roleId], references: [id])
  branches    MembershipBranch[]

  @@unique([tenantId, userId])
  @@index([userId])
  @@map("memberships")
}

model MembershipBranch {
  tenantId     String     @map("tenant_id") @db.Uuid
  membershipId String     @map("membership_id") @db.Uuid
  branchId     String     @map("branch_id") @db.Uuid
  membership   Membership @relation(fields: [membershipId], references: [id], onDelete: Cascade)
  branch       Branch     @relation(fields: [branchId], references: [id])

  @@id([membershipId, branchId])
  @@index([tenantId])
  @@map("membership_branches")
}

model AuditLog {
  id         String   @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  tenantId   String   @map("tenant_id") @db.Uuid
  actorType  String   @map("actor_type")
  actorId    String?  @map("actor_id") @db.Uuid
  branchId   String?  @map("branch_id") @db.Uuid
  action     String
  entityType String   @map("entity_type")
  entityId   String?  @map("entity_id") @db.Uuid
  changes    Json?
  requestId  String?  @map("request_id")
  ip         String?
  createdAt  DateTime @default(now()) @map("created_at") @db.Timestamptz(6)

  @@index([tenantId, entityType, entityId, createdAt])
  @@index([tenantId, createdAt])
  @@map("audit_logs")
}

// ───────────────────────────── Setup ─────────────────────────────

model TenantSettings {
  tenantId                   String   @id @map("tenant_id") @db.Uuid
  priceIncludesTax           Boolean  @default(true) @map("price_includes_tax")
  taxRounding                String   @default("line") @map("tax_rounding")
  allowNegativeStock         Boolean  @default(true) @map("allow_negative_stock")
  valuationMethod            String   @default("weighted_average") @map("valuation_method")
  postingGranularity         String   @default("per_document") @map("posting_granularity")
  businessDayCutoff          String   @default("04:00") @map("business_day_cutoff")
  leaseDays                  Int      @default(7) @map("lease_days")
  refundReturnsStockDefault  Boolean  @default(false) @map("refund_returns_stock_default")
  serviceChargeRate          Decimal  @default(0) @map("service_charge_rate") @db.Decimal(9, 6)
  serviceChargeTaxCategoryId String?  @map("service_charge_tax_category_id") @db.Uuid
  maxDiscountPct             Decimal  @default(0.2) @map("max_discount_pct") @db.Decimal(9, 6)
  rowVersion                 Int      @default(1) @map("row_version")
  updatedAt                  DateTime @updatedAt @map("updated_at") @db.Timestamptz(6)
  updatedBy                  String?  @map("updated_by") @db.Uuid
  tenant                     Tenant   @relation(fields: [tenantId], references: [id])

  @@map("tenant_settings")
}

model Branch {
  id                String             @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  tenantId          String             @map("tenant_id") @db.Uuid
  code              String
  nameAr            String             @map("name_ar")
  nameEn            String             @map("name_en")
  address           String?
  phone             String?
  timezone          String
  currencyCode      String             @map("currency_code") @db.Char(3)
  taxRegistrationNo String?            @map("tax_registration_no")
  status            String             @default("active")
  rowVersion        Int                @default(1) @map("row_version")
  createdAt         DateTime           @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt         DateTime           @updatedAt @map("updated_at") @db.Timestamptz(6)
  createdBy         String?            @map("created_by") @db.Uuid
  updatedBy         String?            @map("updated_by") @db.Uuid
  tenant            Tenant             @relation(fields: [tenantId], references: [id])
  warehouses        Warehouse[]
  memberships       MembershipBranch[]

  @@unique([tenantId, code])
  @@map("branches")
}

model Warehouse {
  id        String   @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  tenantId  String   @map("tenant_id") @db.Uuid
  branchId  String?  @map("branch_id") @db.Uuid
  code      String
  name      String
  kind      String
  isActive  Boolean  @default(true) @map("is_active")
  createdAt DateTime @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt DateTime @updatedAt @map("updated_at") @db.Timestamptz(6)
  branch    Branch?  @relation(fields: [branchId], references: [id])

  @@unique([tenantId, code])
  @@index([branchId])
  @@map("warehouses")
}

// Phase 3 models reference tenants/branches/accounts by plain columns; the same-tenant composite foreign
// keys are declared in SQL (migration 20261030010100_slice_security).

// ───────────────────────────── Taxes & payment methods ─────────────────────────────

model TaxRate {
  id              String            @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  tenantId        String            @map("tenant_id") @db.Uuid
  code            String
  nameAr          String            @map("name_ar")
  nameEn          String            @map("name_en")
  rate            Decimal           @db.Decimal(9, 6)
  kind            String
  validFrom       DateTime          @map("valid_from") @db.Timestamptz(6)
  validTo         DateTime?         @map("valid_to") @db.Timestamptz(6)
  outputAccountId String?           @map("output_account_id") @db.Uuid
  createdAt       DateTime          @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt       DateTime          @updatedAt @map("updated_at") @db.Timestamptz(6)
  categoryRates   TaxCategoryRate[]

  @@unique([tenantId, code])
  @@map("tax_rates")
}

model TaxCategory {
  id         String            @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  tenantId   String            @map("tenant_id") @db.Uuid
  code       String
  nameAr     String            @map("name_ar")
  nameEn     String            @map("name_en")
  archivedAt DateTime?         @map("archived_at") @db.Timestamptz(6)
  createdAt  DateTime          @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt  DateTime          @updatedAt @map("updated_at") @db.Timestamptz(6)
  rates      TaxCategoryRate[]

  @@unique([tenantId, code])
  @@map("tax_categories")
}

model TaxCategoryRate {
  id            String      @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  tenantId      String      @map("tenant_id") @db.Uuid
  taxCategoryId String      @map("tax_category_id") @db.Uuid
  taxRateId     String      @map("tax_rate_id") @db.Uuid
  appliesTo     String      @map("applies_to")
  sequence      Int         @default(1)
  taxCategory   TaxCategory @relation(fields: [taxCategoryId], references: [id])
  taxRate       TaxRate     @relation(fields: [taxRateId], references: [id])

  @@unique([taxCategoryId, taxRateId, appliesTo])
  @@map("tax_category_rates")
}

model PaymentMethod {
  id                String   @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  tenantId          String   @map("tenant_id") @db.Uuid
  code              String
  nameAr            String   @map("name_ar")
  nameEn            String   @map("name_en")
  kind              String
  accountId         String   @map("account_id") @db.Uuid
  opensDrawer       Boolean  @default(false) @map("opens_drawer")
  allowsChange      Boolean  @default(false) @map("allows_change")
  requiresReference Boolean  @default(false) @map("requires_reference")
  isActive          Boolean  @default(true) @map("is_active")
  sort              Int      @default(0)
  createdAt         DateTime @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt         DateTime @updatedAt @map("updated_at") @db.Timestamptz(6)

  @@unique([tenantId, code])
  @@map("payment_methods")
}

// ───────────────────────────── Catalog ─────────────────────────────

model Category {
  id         String    @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  tenantId   String    @map("tenant_id") @db.Uuid
  parentId   String?   @map("parent_id") @db.Uuid
  nameAr     String    @map("name_ar")
  nameEn     String    @map("name_en")
  sort       Int       @default(0)
  /// data: URL (svg/png/jpeg/webp, ≤ ~256 KB): shown on the POS tiles of the category's items.
  image      String?
  archivedAt DateTime? @map("archived_at") @db.Timestamptz(6)
  rowVersion Int       @default(1) @map("row_version")
  createdAt  DateTime  @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt  DateTime  @updatedAt @map("updated_at") @db.Timestamptz(6)
  products   Product[]

  @@index([tenantId])
  @@map("categories")
}

model Product {
  id            String           @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  tenantId      String           @map("tenant_id") @db.Uuid
  categoryId    String           @map("category_id") @db.Uuid
  sku           String?
  nameAr        String           @map("name_ar")
  nameEn        String           @map("name_en")
  kind          String           @default("menu_item")
  taxCategoryId String           @map("tax_category_id") @db.Uuid
  archivedAt    DateTime?        @map("archived_at") @db.Timestamptz(6)
  rowVersion    Int              @default(1) @map("row_version")
  createdAt     DateTime         @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt     DateTime         @updatedAt @map("updated_at") @db.Timestamptz(6)
  createdBy     String?          @map("created_by") @db.Uuid
  updatedBy     String?          @map("updated_by") @db.Uuid
  category      Category         @relation(fields: [categoryId], references: [id])
  variants      ProductVariant[]

  @@index([tenantId])
  @@map("products")
}

model ProductVariant {
  id         String         @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  tenantId   String         @map("tenant_id") @db.Uuid
  productId  String         @map("product_id") @db.Uuid
  nameAr     String?        @map("name_ar")
  nameEn     String?        @map("name_en")
  sku        String?
  isDefault  Boolean        @default(false) @map("is_default")
  sort       Int            @default(0)
  archivedAt DateTime?      @map("archived_at") @db.Timestamptz(6)
  createdAt  DateTime       @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt  DateTime       @updatedAt @map("updated_at") @db.Timestamptz(6)
  product    Product        @relation(fields: [productId], references: [id])
  prices     ProductPrice[]

  @@index([productId])
  @@map("product_variants")
}

model ProductPrice {
  id           String         @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  tenantId     String         @map("tenant_id") @db.Uuid
  variantId    String         @map("variant_id") @db.Uuid
  branchId     String?        @map("branch_id") @db.Uuid
  channel      String?
  price        Decimal        @db.Decimal(19, 4)
  currencyCode String         @map("currency_code") @db.Char(3)
  validFrom    DateTime       @map("valid_from") @db.Timestamptz(6)
  validTo      DateTime?      @map("valid_to") @db.Timestamptz(6)
  createdAt    DateTime       @default(now()) @map("created_at") @db.Timestamptz(6)
  createdBy    String?        @map("created_by") @db.Uuid
  variant      ProductVariant @relation(fields: [variantId], references: [id])

  @@index([variantId])
  @@map("product_prices")
}

// ───────────────────────────── Devices ─────────────────────────────

model Device {
  id                 String        @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  tenantId           String        @map("tenant_id") @db.Uuid
  branchId           String        @map("branch_id") @db.Uuid
  code               String
  name               String
  kind               String        @default("pos")
  status             String        @default("pending_pairing")
  pairingCodeHash    String?       @unique @map("pairing_code_hash")
  pairingExpiresAt   DateTime?     @map("pairing_expires_at") @db.Timestamptz(6)
  appVersion         String?       @map("app_version")
  osVersion          String?       @map("os_version")
  lastSeenAt         DateTime?     @map("last_seen_at") @db.Timestamptz(6)
  localSchemaVersion Int?          @map("local_schema_version")
  createdAt          DateTime      @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt          DateTime      @updatedAt @map("updated_at") @db.Timestamptz(6)
  createdBy          String?       @map("created_by") @db.Uuid
  tokens             DeviceToken[]

  @@unique([tenantId, branchId, code])
  @@map("devices")
}

model DeviceToken {
  id        String    @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  tenantId  String    @map("tenant_id") @db.Uuid
  deviceId  String    @map("device_id") @db.Uuid
  kind      String
  tokenHash String    @unique @map("token_hash")
  familyId  String    @map("family_id") @db.Uuid
  expiresAt DateTime  @map("expires_at") @db.Timestamptz(6)
  usedAt    DateTime? @map("used_at") @db.Timestamptz(6)
  revokedAt DateTime? @map("revoked_at") @db.Timestamptz(6)
  createdAt DateTime  @default(now()) @map("created_at") @db.Timestamptz(6)
  device    Device    @relation(fields: [deviceId], references: [id], onDelete: Cascade)

  @@index([deviceId])
  @@map("device_tokens")
}

// ───────────────────────────── Accounting ─────────────────────────────

model Account {
  id            String    @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  tenantId      String    @map("tenant_id") @db.Uuid
  code          String
  nameAr        String    @map("name_ar")
