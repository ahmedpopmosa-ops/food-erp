  tenantId  String        @map("tenant_id") @db.Uuid
  branchId  String        @map("branch_id") @db.Uuid
  nameAr    String        @map("name_ar")
  nameEn    String        @map("name_en")
  sort      Int           @default(0)
  createdAt DateTime      @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt DateTime      @updatedAt @map("updated_at") @db.Timestamptz(6)
  tables    DiningTable[]

  @@unique([branchId, nameEn])
  @@map("service_areas")
}

model DiningTable {
  id            String      @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  tenantId      String      @map("tenant_id") @db.Uuid
  branchId      String      @map("branch_id") @db.Uuid
  serviceAreaId String      @map("service_area_id") @db.Uuid
  label         String
  seats         Int         @default(4)
  isActive      Boolean     @default(true) @map("is_active")
  createdAt     DateTime    @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt     DateTime    @updatedAt @map("updated_at") @db.Timestamptz(6)
  area          ServiceArea @relation(fields: [serviceAreaId], references: [id])

  @@unique([branchId, label])
  @@map("dining_tables")
}

// ───────────────────────────── Inventory (Phase 5a) ─────────────────────────────

model InventoryItem {
  id           String    @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  tenantId     String    @map("tenant_id") @db.Uuid
  code         String
  nameAr       String    @map("name_ar")
  nameEn       String    @map("name_en")
  kind         String    @default("ingredient")
  baseUnit     String    @map("base_unit")
  standardCost Decimal   @default(0) @map("standard_cost") @db.Decimal(19, 6)
  conversions  Json      @default("{}")
  minQty       Decimal?  @map("min_qty") @db.Decimal(19, 6)
  archivedAt   DateTime? @map("archived_at") @db.Timestamptz(6)
  rowVersion   Int       @default(1) @map("row_version")
  createdAt    DateTime  @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt    DateTime  @updatedAt @map("updated_at") @db.Timestamptz(6)

  @@unique([tenantId, code])
  @@map("inventory_items")
}

model Recipe {
  id        String          @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  tenantId  String          @map("tenant_id") @db.Uuid
  variantId String          @map("variant_id") @db.Uuid
  createdAt DateTime        @default(now()) @map("created_at") @db.Timestamptz(6)
  versions  RecipeVersion[]

  @@unique([tenantId, variantId])
  @@map("recipes")
}

model RecipeVersion {
  id            String       @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  tenantId      String       @map("tenant_id") @db.Uuid
  recipeId      String       @map("recipe_id") @db.Uuid
  version       Int
  yieldQty      Decimal      @map("yield_qty") @db.Decimal(19, 6)
  status        String       @default("active")
  effectiveFrom DateTime     @map("effective_from") @db.Timestamptz(6)
  createdBy     String?      @map("created_by") @db.Uuid
  createdAt     DateTime     @default(now()) @map("created_at") @db.Timestamptz(6)
  recipe        Recipe       @relation(fields: [recipeId], references: [id])
  lines         RecipeLine[]

  @@unique([recipeId, version])
  @@map("recipe_versions")
}

model RecipeLine {
  id              String        @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  tenantId        String        @map("tenant_id") @db.Uuid
  recipeVersionId String        @map("recipe_version_id") @db.Uuid
  itemId          String        @map("item_id") @db.Uuid
  qty             Decimal       @db.Decimal(19, 6)
  unit            String
  qtyBase         Decimal       @map("qty_base") @db.Decimal(19, 6)
  wastePct        Decimal       @default(0) @map("waste_pct") @db.Decimal(9, 6)
  version         RecipeVersion @relation(fields: [recipeVersionId], references: [id])

  @@map("recipe_lines")
}

model StockMovement {
  id             String   @id @db.Uuid
  tenantId       String   @map("tenant_id") @db.Uuid
  warehouseId    String   @map("warehouse_id") @db.Uuid
  itemId         String   @map("item_id") @db.Uuid
  movementType   String   @map("movement_type")
  qtyBase        Decimal  @map("qty_base") @db.Decimal(19, 6)
  unitCost       Decimal  @map("unit_cost") @db.Decimal(19, 6)
  totalCost      Decimal  @map("total_cost") @db.Decimal(19, 4)
  sourceType     String   @map("source_type")
  sourceId       String   @map("source_id") @db.Uuid
  sourceLineId   String?  @map("source_line_id") @db.Uuid
  businessDate   DateTime @map("business_date") @db.Date
  occurredAt     DateTime @map("occurred_at") @db.Timestamptz(6)
  postedAt       DateTime @default(now()) @map("posted_at") @db.Timestamptz(6)
  journalEntryId String?  @map("journal_entry_id") @db.Uuid
  reasonCode     String?  @map("reason_code")

  @@index([tenantId, itemId, warehouseId, postedAt])
  @@index([tenantId, sourceType, sourceId])
  @@map("stock_movements")
}

model StockBalance {
  tenantId    String   @map("tenant_id") @db.Uuid
  warehouseId String   @map("warehouse_id") @db.Uuid
  itemId      String   @map("item_id") @db.Uuid
  qtyBase     Decimal  @default(0) @map("qty_base") @db.Decimal(19, 6)
  totalValue  Decimal  @default(0) @map("total_value") @db.Decimal(19, 4)
  avgUnitCost Decimal  @default(0) @map("avg_unit_cost") @db.Decimal(19, 6)
  updatedAt   DateTime @updatedAt @map("updated_at") @db.Timestamptz(6)

  @@id([warehouseId, itemId])
  @@index([tenantId])
  @@map("stock_balances")
}

model StockAdjustment {
  id             String                @id @db.Uuid
  tenantId       String                @map("tenant_id") @db.Uuid
  warehouseId    String                @map("warehouse_id") @db.Uuid
  number         String
  kind           String
  reason         String
  status         String                @default("posted")
  postedAt       DateTime              @default(now()) @map("posted_at") @db.Timestamptz(6)
  journalEntryId String?               @map("journal_entry_id") @db.Uuid
  createdBy      String?               @map("created_by") @db.Uuid
  lines          StockAdjustmentLine[]

  @@unique([tenantId, number])
  @@map("stock_adjustments")
}

model StockAdjustmentLine {
  id           String          @id @db.Uuid
  tenantId     String          @map("tenant_id") @db.Uuid
  adjustmentId String          @map("adjustment_id") @db.Uuid
  itemId       String          @map("item_id") @db.Uuid
  qty          Decimal         @db.Decimal(19, 6)
  unit         String
  qtyBase      Decimal         @map("qty_base") @db.Decimal(19, 6)
  unitCost     Decimal?        @map("unit_cost") @db.Decimal(19, 6)
  adjustment   StockAdjustment @relation(fields: [adjustmentId], references: [id])

  @@map("stock_adjustment_lines")
}

model StockCount {
  id             String           @id @db.Uuid
  tenantId       String           @map("tenant_id") @db.Uuid
  warehouseId    String           @map("warehouse_id") @db.Uuid
  number         String
  status         String           @default("in_progress")
  snapshotAt     DateTime         @map("snapshot_at") @db.Timestamptz(6)
  approvedBy     String?          @map("approved_by") @db.Uuid
  approvedAt     DateTime?        @map("approved_at") @db.Timestamptz(6)
  journalEntryId String?          @map("journal_entry_id") @db.Uuid
  createdBy      String?          @map("created_by") @db.Uuid
  createdAt      DateTime         @default(now()) @map("created_at") @db.Timestamptz(6)
  lines          StockCountLine[]

  @@unique([tenantId, number])
  @@map("stock_counts")
}

model StockCountLine {
  id            String     @id @db.Uuid
  tenantId      String     @map("tenant_id") @db.Uuid
  countId       String     @map("count_id") @db.Uuid
  itemId        String     @map("item_id") @db.Uuid
  systemQty     Decimal    @map("system_qty") @db.Decimal(19, 6)
  countedQty    Decimal?   @map("counted_qty") @db.Decimal(19, 6)
  differenceQty Decimal?   @map("difference_qty") @db.Decimal(19, 6)
  count         StockCount @relation(fields: [countId], references: [id])

  @@unique([countId, itemId])
  @@map("stock_count_lines")
}

model StockTransfer {
  id                String              @id @db.Uuid
  tenantId          String              @map("tenant_id") @db.Uuid
  number            String
  fromWarehouseId   String              @map("from_warehouse_id") @db.Uuid
  toWarehouseId     String              @map("to_warehouse_id") @db.Uuid
  status            String              @default("draft")
  dispatchedAt      DateTime?           @map("dispatched_at") @db.Timestamptz(6)
  dispatchedBy      String?             @map("dispatched_by") @db.Uuid
  receivedAt        DateTime?           @map("received_at") @db.Timestamptz(6)
  receivedBy        String?             @map("received_by") @db.Uuid
  dispatchJournalId String?             @map("dispatch_journal_id") @db.Uuid
  receiveJournalId  String?             @map("receive_journal_id") @db.Uuid
  createdBy         String?             @map("created_by") @db.Uuid
  createdAt         DateTime            @default(now()) @map("created_at") @db.Timestamptz(6)
  lines             StockTransferLine[]

  @@unique([tenantId, number])
  @@map("stock_transfers")
}

model StockTransferLine {
  id          String        @id @db.Uuid
  tenantId    String        @map("tenant_id") @db.Uuid
  transferId  String        @map("transfer_id") @db.Uuid
  itemId      String        @map("item_id") @db.Uuid
  qtySent     Decimal       @map("qty_sent") @db.Decimal(19, 6)
  qtyReceived Decimal?      @map("qty_received") @db.Decimal(19, 6)
  unitCost    Decimal?      @map("unit_cost") @db.Decimal(19, 6)
  transfer    StockTransfer @relation(fields: [transferId], references: [id])

  @@unique([transferId, itemId])
  @@map("stock_transfer_lines")
}

// ───────────────────────────── Purchasing (Phase 5b) ─────────────────────────────
// Same-tenant composite foreign keys, checks and immutability live in SQL (20261101000100_purchasing_security).

model Supplier {
  id               String    @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  tenantId         String    @map("tenant_id") @db.Uuid
  code             String
  nameAr           String    @map("name_ar")
  nameEn           String    @map("name_en")
  taxNumber        String?   @map("tax_number")
  phone            String?
  email            String?
  paymentTermsDays Int       @default(0) @map("payment_terms_days")
  archivedAt       DateTime? @map("archived_at") @db.Timestamptz(6)
  createdAt        DateTime  @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt        DateTime  @updatedAt @map("updated_at") @db.Timestamptz(6)

  @@unique([tenantId, code])
  @@map("suppliers")
}

model PurchaseOrder {
  id           String              @id @db.Uuid
  tenantId     String              @map("tenant_id") @db.Uuid
  number       String
  supplierId   String              @map("supplier_id") @db.Uuid
  warehouseId  String              @map("warehouse_id") @db.Uuid
  status       String              @default("draft")
  expectedDate DateTime?           @map("expected_date") @db.Date
  notes        String?
  total        Decimal             @db.Decimal(19, 4)
  createdBy    String?             @map("created_by") @db.Uuid
  approvedBy   String?             @map("approved_by") @db.Uuid
  approvedAt   DateTime?           @map("approved_at") @db.Timestamptz(6)
  createdAt    DateTime            @default(now()) @map("created_at") @db.Timestamptz(6)
  lines        PurchaseOrderLine[]

  @@unique([tenantId, number])
  @@index([tenantId, supplierId])
  @@map("purchase_orders")
}

model PurchaseOrderLine {
  id              String        @id @db.Uuid
  tenantId        String        @map("tenant_id") @db.Uuid
  orderId         String        @map("order_id") @db.Uuid
  itemId          String        @map("item_id") @db.Uuid
  qty             Decimal       @db.Decimal(19, 6)
  unit            String
  qtyBase         Decimal       @map("qty_base") @db.Decimal(19, 6)
  unitPrice       Decimal       @map("unit_price") @db.Decimal(19, 6)
  qtyReceivedBase Decimal       @default(0) @map("qty_received_base") @db.Decimal(19, 6)
  order           PurchaseOrder @relation(fields: [orderId], references: [id])

  @@unique([orderId, itemId])
  @@map("purchase_order_lines")
}

model GoodsReceipt {
  id             String             @id @db.Uuid
  tenantId       String             @map("tenant_id") @db.Uuid
  number         String
  supplierId     String             @map("supplier_id") @db.Uuid
  orderId        String?            @map("order_id") @db.Uuid
  warehouseId    String             @map("warehouse_id") @db.Uuid
  supplierRef    String?            @map("supplier_ref")
  goodsTotal     Decimal            @map("goods_total") @db.Decimal(19, 4)
  chargesTotal   Decimal            @map("charges_total") @db.Decimal(19, 4)
  charges        Json               @default("[]")
  receivedAt     DateTime           @default(now()) @map("received_at") @db.Timestamptz(6)
  journalEntryId String?            @map("journal_entry_id") @db.Uuid
  createdBy      String?            @map("created_by") @db.Uuid
  lines          GoodsReceiptLine[]

  @@unique([tenantId, number])
  @@index([tenantId, supplierId])
  @@map("goods_receipts")
}

model GoodsReceiptLine {
  id              String       @id @db.Uuid
  tenantId        String       @map("tenant_id") @db.Uuid
  receiptId       String       @map("receipt_id") @db.Uuid
  orderLineId     String?      @map("order_line_id") @db.Uuid
  itemId          String       @map("item_id") @db.Uuid
  qty             Decimal      @db.Decimal(19, 6)
  unit            String
  qtyBase         Decimal      @map("qty_base") @db.Decimal(19, 6)
  unitPrice       Decimal      @map("unit_price") @db.Decimal(19, 6)
  goodsValue      Decimal      @map("goods_value") @db.Decimal(19, 4)
  chargesValue    Decimal      @map("charges_value") @db.Decimal(19, 4)
  qtyInvoicedBase Decimal      @default(0) @map("qty_invoiced_base") @db.Decimal(19, 6)
  qtyReturnedBase Decimal      @default(0) @map("qty_returned_base") @db.Decimal(19, 6)
  /// Goods value already taken out of "goods received not invoiced" by invoices and returns.
  valueCleared    Decimal      @default(0) @map("value_cleared") @db.Decimal(19, 4)
  receipt         GoodsReceipt @relation(fields: [receiptId], references: [id])

  @@unique([receiptId, itemId])
  @@map("goods_receipt_lines")
}

model SupplierInvoice {
  id                String                @id @db.Uuid
  tenantId          String                @map("tenant_id") @db.Uuid
  number            String
  supplierId        String                @map("supplier_id") @db.Uuid
  supplierInvoiceNo String                @map("supplier_invoice_no")
  invoiceDate       DateTime              @map("invoice_date") @db.Date
  dueDate           DateTime              @map("due_date") @db.Date
  subtotal          Decimal               @db.Decimal(19, 4)
  taxTotal          Decimal               @map("tax_total") @db.Decimal(19, 4)
  total             Decimal               @db.Decimal(19, 4)
  amountPaid        Decimal               @default(0) @map("amount_paid") @db.Decimal(19, 4)
  status            String                @default("open")
  journalEntryId    String?               @map("journal_entry_id") @db.Uuid
  createdBy         String?               @map("created_by") @db.Uuid
  createdAt         DateTime              @default(now()) @map("created_at") @db.Timestamptz(6)
  lines             SupplierInvoiceLine[]

  @@unique([tenantId, number])
  @@unique([tenantId, supplierId, supplierInvoiceNo])
  @@map("supplier_invoices")
}

model SupplierInvoiceLine {
  id            String          @id @db.Uuid
  tenantId      String          @map("tenant_id") @db.Uuid
  invoiceId     String          @map("invoice_id") @db.Uuid
  receiptLineId String?         @map("receipt_line_id") @db.Uuid
  accountId     String?         @map("account_id") @db.Uuid
  description   String?
  qtyBase       Decimal?        @map("qty_base") @db.Decimal(19, 6)
  amount        Decimal         @db.Decimal(19, 4)
  taxAmount     Decimal         @map("tax_amount") @db.Decimal(19, 4)
  grniCleared   Decimal         @default(0) @map("grni_cleared") @db.Decimal(19, 4)
  priceVariance Decimal         @default(0) @map("price_variance") @db.Decimal(19, 4)
  invoice       SupplierInvoice @relation(fields: [invoiceId], references: [id])

  @@map("supplier_invoice_lines")
}

model SupplierPayment {
  id             String                      @id @db.Uuid
  tenantId       String                      @map("tenant_id") @db.Uuid
  number         String
  supplierId     String                      @map("supplier_id") @db.Uuid
  method         String
  amount         Decimal                     @db.Decimal(19, 4)
  reference      String?
  paidAt         DateTime                    @default(now()) @map("paid_at") @db.Timestamptz(6)
  journalEntryId String?                     @map("journal_entry_id") @db.Uuid
  createdBy      String?                     @map("created_by") @db.Uuid
  allocations    SupplierPaymentAllocation[]

  @@unique([tenantId, number])
  @@index([tenantId, supplierId])
  @@map("supplier_payments")
}

model SupplierPaymentAllocation {
  id        String          @id @db.Uuid
  tenantId  String          @map("tenant_id") @db.Uuid
  paymentId String          @map("payment_id") @db.Uuid
  invoiceId String          @map("invoice_id") @db.Uuid
  amount    Decimal         @db.Decimal(19, 4)
  payment   SupplierPayment @relation(fields: [paymentId], references: [id])

  @@unique([paymentId, invoiceId])
  @@map("supplier_payment_allocations")
}

model SupplierReturn {
  id             String               @id @db.Uuid
  tenantId       String               @map("tenant_id") @db.Uuid
  number         String
  supplierId     String               @map("supplier_id") @db.Uuid
  receiptId      String               @map("receipt_id") @db.Uuid
  warehouseId    String               @map("warehouse_id") @db.Uuid
  reason         String
  journalEntryId String?              @map("journal_entry_id") @db.Uuid
  createdBy      String?              @map("created_by") @db.Uuid
  createdAt      DateTime             @default(now()) @map("created_at") @db.Timestamptz(6)
  lines          SupplierReturnLine[]

  @@unique([tenantId, number])
  @@map("supplier_returns")
}

model SupplierReturnLine {
  id            String         @id @db.Uuid
  tenantId      String         @map("tenant_id") @db.Uuid
  returnId      String         @map("return_id") @db.Uuid
  receiptLineId String         @map("receipt_line_id") @db.Uuid
  itemId        String         @map("item_id") @db.Uuid
  qty           Decimal        @db.Decimal(19, 6)
  unit          String
  qtyBase       Decimal        @map("qty_base") @db.Decimal(19, 6)
  grniValue     Decimal        @map("grni_value") @db.Decimal(19, 4)
  stockValue    Decimal        @map("stock_value") @db.Decimal(19, 4)
  return        SupplierReturn @relation(fields: [returnId], references: [id])

  @@map("supplier_return_lines")
}

// ───────────────────────────── Bank reconciliation (Phase 6b) ─────────────────────────────

model BankStatement {
  id             String              @id @db.Uuid
  tenantId       String              @map("tenant_id") @db.Uuid
  accountId      String              @map("account_id") @db.Uuid
  reference      String
  startDate      DateTime            @map("start_date") @db.Date
  endDate        DateTime            @map("end_date") @db.Date
  openingBalance Decimal             @map("opening_balance") @db.Decimal(19, 4)
  closingBalance Decimal             @map("closing_balance") @db.Decimal(19, 4)
  status         String              @default("open")
  createdBy      String?             @map("created_by") @db.Uuid
  createdAt      DateTime            @default(now()) @map("created_at") @db.Timestamptz(6)
  reconciledAt   DateTime?           @map("reconciled_at") @db.Timestamptz(6)
  reconciledBy   String?             @map("reconciled_by") @db.Uuid
  lines          BankStatementLine[]

  @@unique([tenantId, accountId, reference])
  @@map("bank_statements")
}

model BankStatementLine {
  id            String        @id @db.Uuid
  tenantId      String        @map("tenant_id") @db.Uuid
  statementId   String        @map("statement_id") @db.Uuid
  lineNo        Int           @map("line_no")
  txnDate       DateTime      @map("txn_date") @db.Date
  description   String
  reference     String?
  amount        Decimal       @db.Decimal(19, 4)
  /// The posted journal line (same account, same signed amount) this bank line is matched to.
  journalLineId String?       @unique @map("journal_line_id") @db.Uuid
  matchedAt     DateTime?     @map("matched_at") @db.Timestamptz(6)
  matchedBy     String?       @map("matched_by") @db.Uuid
  statement     BankStatement @relation(fields: [statementId], references: [id])

  @@unique([statementId, lineNo])
  @@map("bank_statement_lines")
}

// ───────────────────────────── Kitchen display (Phase 7a) ─────────────────────────────

model KitchenStation {
  id                String                @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  tenantId          String                @map("tenant_id") @db.Uuid
  branchId          String                @map("branch_id") @db.Uuid
  code              String
  nameAr            String                @map("name_ar")
  nameEn            String                @map("name_en")
  delayThresholdSec Int                   @default(600) @map("delay_threshold_sec")
  isDefault         Boolean               @default(false) @map("is_default")
  isActive          Boolean               @default(true) @map("is_active")
  createdAt         DateTime              @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt         DateTime              @updatedAt @map("updated_at") @db.Timestamptz(6)
  routes            KitchenStationRoute[]

  @@unique([branchId, code])
  @@index([tenantId, branchId])
  @@map("kitchen_stations")
}

/// Category → station of one branch (a category goes to one station per branch).
model KitchenStationRoute {
  tenantId   String         @map("tenant_id") @db.Uuid
  branchId   String         @map("branch_id") @db.Uuid
  categoryId String         @map("category_id") @db.Uuid
  stationId  String         @map("station_id") @db.Uuid
  station    KitchenStation @relation(fields: [stationId], references: [id])

  @@id([branchId, categoryId])
  @@index([stationId])
  @@map("kitchen_station_routes")
}

model KitchenTicket {
  id          String              @id @db.Uuid
  tenantId    String              @map("tenant_id") @db.Uuid
  branchId    String              @map("branch_id") @db.Uuid
  stationId   String              @map("station_id") @db.Uuid
  orderId     String              @map("order_id") @db.Uuid
  fireId      String              @map("fire_id") @db.Uuid
  ticketNo    Int                 @map("ticket_no")
  label       String
  channel     String
  status      String              @default("new")
  firedAt     DateTime            @map("fired_at") @db.Timestamptz(6)
  receivedAt  DateTime            @default(now()) @map("received_at") @db.Timestamptz(6)
  startedAt   DateTime?           @map("started_at") @db.Timestamptz(6)
  readyAt     DateTime?           @map("ready_at") @db.Timestamptz(6)
  servedAt    DateTime?           @map("served_at") @db.Timestamptz(6)
  cancelledAt DateTime?           @map("cancelled_at") @db.Timestamptz(6)
  items       KitchenTicketItem[]

  @@index([tenantId, branchId, status])
  @@index([tenantId, orderId])
  @@map("kitchen_tickets")
}

model KitchenTicketItem {
  id          String        @id @db.Uuid
  tenantId    String        @map("tenant_id") @db.Uuid
  ticketId    String        @map("ticket_id") @db.Uuid
  orderItemId String        @map("order_item_id") @db.Uuid
  nameAr      String        @map("name_ar")
  nameEn      String        @map("name_en")
  qty         Decimal       @db.Decimal(19, 6)
  modifiers   Json          @default("[]")
  voidedAt    DateTime?     @map("voided_at") @db.Timestamptz(6)
  voidReason  String?       @map("void_reason")
  ticket      KitchenTicket @relation(fields: [ticketId], references: [id])

  @@index([tenantId, orderItemId])
  @@map("kitchen_ticket_items")
}

/// Append-only history of every ticket state change (P7-5: state changes are audited).
model KitchenTicketEvent {
  id         String   @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  tenantId   String   @map("tenant_id") @db.Uuid
  ticketId   String   @map("ticket_id") @db.Uuid
  fromStatus String?  @map("from_status")
  toStatus   String   @map("to_status")
  actorType  String   @map("actor_type")
  actorId    String?  @map("actor_id") @db.Uuid
  note       String?
  occurredAt DateTime @default(now()) @map("occurred_at") @db.Timestamptz(6)

  @@index([tenantId, ticketId])
  @@map("kitchen_ticket_events")
}
