# Copy to apps/api/.env for local development. Never commit real values.

NODE_ENV=development

# Application connection: restricted role `ros_app` (NOBYPASSRLS) - Row-Level Security is enforced.
DATABASE_URL="postgresql://ros_app:ros_app_dev@localhost:5433/restaurant_os?schema=public"
# Owner connection: used only by migrations, permission sync and the dev seed.
DATABASE_OWNER_URL="postgresql://postgres:postgres@localhost:5433/restaurant_os?schema=public"

API_PORT=4000
WEB_ORIGIN="http://localhost:5173"
ADMIN_ORIGIN="http://localhost:5174"
APP_BASE_URL="http://localhost:5173"

# true behind HTTPS (required in production).
COOKIE_SECURE=false
SESSION_IDLE_HOURS=12
SESSION_ABSOLUTE_HOURS=168

# Argon2id cost (doc 05 section 5). Lower only for tests.
ARGON2_MEMORY_KIB=65536
ARGON2_TIME_COST=3
LOGIN_LOCKOUT_THRESHOLD=10
LOGIN_LOCKOUT_MINUTES=15

# Only `log` exists today (keeps mail in memory, logs that a message was queued). Production refuses to start with it.
MAIL_TRANSPORT=log

# Reserved for later phases (not read yet):
# REDIS_URL="redis://localhost:6379"
# S3_ENDPOINT="http://localhost:9000"
# S3_BUCKET="restaurant-os"
# S3_ACCESS_KEY=""
# S3_SECRET_KEY=""
